# =================================================================
# ForexDoubleSniper - Environment Variables Configuration
# =================================================================

# 1. CORE SERVER & AUTHENTICATION (REQUIRED)
PORT=3000
NODE_ENV=production
JWT_SECRET=generate_a_random_secure_jwt_secret_here

# 2. DATABASE (REQUIRED FOR PRODUCTION)
# Your Neon PostgreSQL connection string (with ?sslmode=require)
DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. EMAIL DELIVERY (RESEND API - RECOMMENDED)
# Get your API key for free at https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=ForexDoubleSniper <onboarding@resend.dev>

# 4. EMAIL DELIVERY (SMTP FALLBACK - OPTIONAL)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=ForexDoubleSniper <noreply@yourdomain.com>

# 5. MARKET SIGNALS (100% ZERO-KEY / FREE)
# NOTE: Gold (XAU/USD via Swiftedge & Binance PAXG) and GBP/USD / GBP/JPY
# use public zero-key feeds. No API keys or subscriptions required!

# 6. FLUTTERWAVE PAYMENT GATEWAY (OPTIONAL - CAN ALSO BE SET IN /admin)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_APIE-xxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_HASH=your_webhook_secret_hash

# 7. GOOGLE DRIVE STORAGE BACKUP (OPTIONAL - CAN ALSO BE SET IN /admin)
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_oauth_client_secret
GOOGLE_REFRESH_TOKEN=1//04your_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
