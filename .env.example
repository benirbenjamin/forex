# Server configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secure_forex_jwt_secret_key_fds_2026_change_in_production

# Database (Neon PostgreSQL)
# Example: postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Market Data Providers
# Option A: OANDA prices (practice host: https://api-fxpractice.oanda.com)
OANDA_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_HOST=https://api-fxtrade.oanda.com
# Option B: Twelve Data prices
TWELVEDATA_KEY=
# Option C: Finnhub news sentiment (optional)
FINNHUB_KEY=

# Flutterwave Payment Gateway (Configurable also in Admin Panel)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Google Drive Storage (Configurable also in Admin Panel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Email SMTP (Optional for OTP, fallback to console logs if not configured)
